[Unit]
Description=Masterarbeit: Scraper (Volltexte aller Medien, Workerzahl nach Rechnerlast)

[Service]
# systemd-User-Dienst: ~/.config/systemd/user/ ; Projektordner = Arbeitsverzeichnis (%h = Home)
Type=exec
WorkingDirectory=%h/Projekte/Masterarbeit_Nahost_Presentable
ExecStart=%h/Projekte/Masterarbeit_Nahost_Presentable/skripte/scraper_start.sh
# Arbeitsspeicher begrenzen, damit der Rechner benutzbar bleibt
MemoryHigh=13G
MemoryMax=15G
MemorySwapMax=256M
CPUWeight=20
IOWeight=20
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=30
# nach jedem Durchlauf nach 10 Minuten neu starten: neue URLs und zurückgestellte Medien kommen dran
Restart=always
RestartSec=10min
